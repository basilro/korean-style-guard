{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/절대/경로/korean-style-guard/hooks/inject-rules.sh\"",
            "timeoutSec": 10
          },
          {
            "type": "command",
            "command": "bash \"/절대/경로/korean-style-guard/hooks/inject-rules.sh\" ko-style-examples.md",
            "timeoutSec": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/절대/경로/korean-style-guard/hooks/check-output.sh\"",
            "timeoutSec": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/절대/경로/korean-style-guard/hooks/check-written-file.sh\"",
            "timeoutSec": 15
          }
        ]
      }
    ]
  }
}
